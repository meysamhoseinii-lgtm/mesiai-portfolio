{
  "name": "mesiai",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-12",
  "workers_dev": true,
  "assets": {"directory":"./public","binding":"ASSETS","run_worker_first":["/api/*"]},
  "ai": {"binding":"AI"},
  "vars": {"AI_ENABLED":"false", "AI_MODEL":"@cf/meta/llama-3.1-8b-instruct"},
  "ratelimits": [{"name":"CHAT_LIMITER","namespace_id":"1001","simple":{"limit":5,"period":60}}]
}
